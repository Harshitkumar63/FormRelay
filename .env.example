# Database - Use PostgreSQL in production, SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///./formrelay.db
# DATABASE_URL=postgresql+asyncpg://formrelay:changeme@localhost:5432/formrelay

# Backend
SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173
API_PREFIX=/api
DEBUG=true

# Frontend (Vite uses VITE_ prefix)
VITE_API_URL=http://localhost:8000
